# Bootstrap Italia v3 – theme .gitignore

# Build dependencies (npm).
# Upstream bootstrap-italia is a devDependency: SCSS/JS sources are used
# only at build time. Run `npm install && npm run build` to rebuild.
node_modules
dist
assets
package-lock.json
.eslintcache
.stylelintcache
.sass-cache
.vite

# Numerous always-ignore extensions
*.diff
*.err
*.log
*.orig
*.rej
*.swo
*.swp
*.vi
*.zip
*~

# OS or Editor folders
._*
.cache
.DS_Store
.idea
.project
.settings
.tmproj
.publish
*.esproj
*.sublime-project
*.sublime-workspace
nbproject
Thumbs.db
.vscode
.claude

# Subtheme ignore
/components/*/*.css
/components/*/*.js
!/components/*/_*.js

*storybook.log
debug-storybook.log
storybook-static/
stories/
