{#
/**
 * @file
 * Bootstrap Italia v3 – Badge component.
 *
 * Thin inline label with optional link behavior.
 * The base `.badge` class is always injected automatically.
 * Renders as `<span>` by default or delegates to `bootstrap_italia:link` when
 * the `url` prop is provided.
 *
 * Last revision: v3.0.0-alpha.6
 *
 * Props:
 *   - variant    (string): Optional SDC variant used as a convenience layer
 *                          to derive internal defaults using the pattern
 *                          `{tone}[__{modifier}]*`. Supported tones:
 *                          `primary`, `secondary`, `success`, `warning`,
 *                          `danger`, `disabled`, `inverse`, `light`, `white`.
 *                          Supported modifiers: `small`.
 *   - label      (string, required): Short badge text, such as a count, status,
 *                                    or compact keyword.
 *   - color      (string): Optional color modifier such as `primary`,
 *                          `secondary`, `success`, `warning`, `danger`,
 *                          `disabled`, `inverse`, `light`, or `white`.
 *   - small      (bool): Adds the compact `badge-sm` modifier. Useful when the
 *                        badge is nested inside buttons or dense UI.
 *   - rounded    (bool): Adds the `rounded-pill` modifier.
 *   - url        (string): Optional link destination. When provided, the badge
 *                          is rendered through `bootstrap_italia:link`.
 *   - attributes (Drupal\Core\Template\Attribute): Attributes applied to the
 *                          rendered badge element.
 *
 * Slots: none.
 *
 * ── Usage: simple badge ────────────────────────────────────────────────────
 *   {% include 'bootstrap_italia:badge' with {
 *     label: '5',
 *     color: 'primary',
 *   } only %}
 *
 * ── Usage: pill badge ─────────────────────────────────────────────────────
 *   {% include 'bootstrap_italia:badge' with {
 *     label: 'New',
 *     color: 'secondary',
 *     rounded: true,
 *   } only %}
 *
 * ── Usage: link badge ─────────────────────────────────────────────────────
 *   {% include 'bootstrap_italia:badge' with {
 *     label: 'News',
 *     color: 'primary',
 *     url: '/news',
 *     attributes: create_attribute({'class': ['custom-class']}),
 *   } only %}
 *
 * ── Usage: mapping from Drupal link data ──────────────────────────────────
 *   {% include 'bootstrap_italia:badge' with {
 *     label: item.title,
 *     url: item.url.toString(),
 *     attributes: item.attributes,
 *     color: 'secondary',
 *   } only %}
 *
 */
#}
{% apply spaceless %}
  {# Defaults #}
  {% set _variant = variant|default('') %}
  {% set _variant_parts = _variant ? _variant|split('__') : [] %}
  {% set _variant_tone = _variant_parts|length ? _variant_parts|first : '' %}
  {% set _variant_modifiers = _variant_parts|slice(1) %}
  {% set _variant_color = _variant_tone in ['primary', 'secondary', 'success', 'warning', 'danger', 'disabled', 'inverse', 'light', 'white'] ? _variant_tone : '' %}
  {% set _variant_small = 'small' in _variant_modifiers %}
  {% set _label = label|default('') %}
  {% set _color = color|default(_variant_color ?: 'secondary') %}
  {% set _small = small ?? _variant_small %}
  {% set _rounded = rounded ?? false %}
  {% set _url = url|default('') %}
  {% set _attributes = attributes|default(create_attribute()) %}

  {# Configuration #}
  {% set _classes = [
    'badge',
    'badge-' ~ _color,
    _small ? 'badge-sm',
    _rounded ? 'rounded-pill'
  ] %}

  {% set _attributes = _attributes.setAttribute(
    'class',
    _classes|merge(_attributes.class|default([]))
  ) %}

  {# Component #}
  {% if _url %}
    {% include 'bootstrap_italia:link' with {
      url: _url,
      label: _label,
      attributes: _attributes,
    } only %}
  {% else %}
    <span{{ _attributes }}>{{ _label }}</span>
  {% endif %}
{% endapply %}
