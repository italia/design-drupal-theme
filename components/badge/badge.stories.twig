{% stories badge with { title: 'Bootstrap Italia/Components/Badge' } %}

  {% story headings with { name: '1. Headings' } %}
    <div class="d-flex flex-column gap-3">
      <h1>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'primary', attributes: create_attribute() } only %}</h1>
      <h2>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'secondary', attributes: create_attribute() } only %}</h2>
      <h3>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'success', attributes: create_attribute() } only %}</h3>
      <h4>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'warning', attributes: create_attribute() } only %}</h4>
      <h5>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'danger', attributes: create_attribute() } only %}</h5>
      <h6>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'inverse', attributes: create_attribute() } only %}</h6>
    </div>
  {% endstory %}

  {% story button_counter with { name: '2. Button with counter' } %}
    {% embed 'bootstrap_italia:button' with {
      label: 'Notifications',
      color: 'primary',
      attributes: create_attribute(),
    } only %}
      {% block after %}
        {% include 'bootstrap_italia:badge' with {
          label: '4',
          color: 'inverse',
          small: true,
          rounded: true,
          attributes: create_attribute(),
        } only %}
      {% endblock %}
    {% endembed %}
  {% endstory %}

  {% story button_counter_accessible with { name: '3. Button with accessible counter' } %}
    {% embed 'bootstrap_italia:button' with {
      label: 'Messages',
      color: 'primary',
      attributes: create_attribute(),
    } only %}
      {% block after %}
        {% include 'bootstrap_italia:badge' with {
          label: '7',
          color: 'inverse',
          small: true,
          rounded: true,
          attributes: create_attribute(),
        } only %}
        <span class="visually-hidden">{{ 'unread messages'|t }}</span>
      {% endblock %}
    {% endembed %}
  {% endstory %}

  {% story contextual_colors with { name: '4. Contextual colors' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:badge' with { label: 'Primary', color: 'primary', attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Secondary', color: 'secondary', attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Success', color: 'success', attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Warning', color: 'warning', attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Danger', color: 'danger', attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with {
        label: 'Light',
        color: 'light',
        attributes: create_attribute({'class': ['bg-dark']}),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        label: 'White',
        color: 'white',
        attributes: create_attribute({'class': ['bg-dark']}),
      } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Inverse', color: 'inverse', attributes: create_attribute() } only %}
    </div>
  {% endstory %}

  {% story rounded_pills with { name: '5. Rounded pills' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:badge' with { label: 'Primary', color: 'primary', rounded: true, attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Secondary', color: 'secondary', rounded: true, attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Success', color: 'success', rounded: true, attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Warning', color: 'warning', rounded: true, attributes: create_attribute() } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Danger', color: 'danger', rounded: true, attributes: create_attribute() } only %}
    </div>
  {% endstory %}

  {% story links with { name: '6. Link badges' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:badge' with {
        label: 'News',
        color: 'primary',
        url: '#',
        attributes: create_attribute({'class': ['custom-class']}),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        label: 'Services',
        color: 'secondary',
        rounded: true,
        url: '#',
        attributes: create_attribute({'class': ['custom-class']}),
      } only %}
    </div>
  {% endstory %}

  {% story variants with { name: '7. Variants' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:badge' with {
        variant: 'primary',
        label: 'Primary',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'secondary',
        label: 'Secondary',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'success',
        label: 'Success',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'warning',
        label: 'Warning',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'danger',
        label: 'Danger',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'inverse',
        label: 'Inverse',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'primary__small',
        label: 'Primary small',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'warning__small',
        label: 'Warning small',
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        variant: 'inverse__small',
        label: 'Inverse small',
        attributes: create_attribute(),
      } only %}
    </div>
  {% endstory %}

{% endstories %}
