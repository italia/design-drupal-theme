{% stories badge with { title: 'Bootstrap Italia/Components/Badge' } %}

  {% story headings with { name: '1. Headings' } %}
    <div class="d-flex flex-column gap-3">
      <h1>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'primary' } only %}</h1>
      <h2>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'secondary' } only %}</h2>
      <h3>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'success' } only %}</h3>
      <h4>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'warning' } only %}</h4>
      <h5>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'danger' } only %}</h5>
      <h6>Example heading {% include 'bootstrap_italia:badge' with { label: 'New', color: 'inverse' } only %}</h6>
    </div>
  {% endstory %}

  {% story button_counter with { name: '2. Button with counter' } %}
    <button type="button" class="btn btn-primary">
      Notifications
      {% include 'bootstrap_italia:badge' with {
        label: '4',
        color: 'inverse',
        small: true,
        rounded: true,
      } only %}
    </button>
  {% endstory %}

  {% story button_counter_accessible with { name: '3. Button with accessible counter' } %}
    <button type="button" class="btn btn-primary">
      Messages
      {% include 'bootstrap_italia:badge' with {
        label: '7',
        color: 'inverse',
        small: true,
        rounded: true,
      } only %}
      <span class="visually-hidden">{{ 'unread messages'|t }}</span>
    </button>
  {% endstory %}

  {% story contextual_colors with { name: '4. Contextual colors' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:badge' with { label: 'Primary', color: 'primary' } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Secondary', color: 'secondary' } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Success', color: 'success' } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Warning', color: 'warning' } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Danger', color: 'danger' } only %}
      {% include 'bootstrap_italia:badge' with {
        label: 'Light',
        color: 'light',
        attributes: create_attribute({'class': ['bg-dark']}),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        label: 'White',
        color: 'white',
        attributes: create_attribute({'class': ['bg-dark']}),
      } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Inverse', color: 'inverse' } only %}
    </div>
  {% endstory %}

  {% story rounded_pills with { name: '5. Rounded pills' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:badge' with { label: 'Primary', color: 'primary', rounded: true } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Secondary', color: 'secondary', rounded: true } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Success', color: 'success', rounded: true } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Warning', color: 'warning', rounded: true } only %}
      {% include 'bootstrap_italia:badge' with { label: 'Danger', color: 'danger', rounded: true } only %}
    </div>
  {% endstory %}

  {% story links with { name: '6. Link badges' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:badge' with {
        label: 'News',
        color: 'primary',
        url: '#',
        attributes: create_attribute({'class': ['custom-class']}),
      } only %}
      {% include 'bootstrap_italia:badge' with {
        label: 'Services',
        color: 'secondary',
        rounded: true,
        url: '#',
        attributes: create_attribute({'class': ['custom-class']}),
      } only %}
    </div>
  {% endstory %}

{% endstories %}
