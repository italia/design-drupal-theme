{% stories link with { title: 'Bootstrap Italia/Primitives/Link' } %}

  {% story default with { name: '1. Default', args: { url: 'https://www.example.com', label: 'Leggi di più' } } %}
    {% include 'bootstrap_italia:link' with { url: url, label: label } only %}
  {% endstory %}

  {% story primary with { name: '2. Primary (link-primary)', args: { url: 'https://www.example.com', label: 'Link primario' } } %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: create_attribute({'class': ['link-primary']}),
    } only %}
  {% endstory %}

  {% story external with { name: '3. External', args: { url: 'https://www.example.com', label: 'Sito esterno' } } %}
    {% set link_attr = create_attribute({'class': ['link-primary']}) %}
    {% set link_attr = link_attr.setAttribute('target', '_blank') %}
    {% set link_attr = link_attr.setAttribute('rel', 'noopener noreferrer') %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: link_attr,
    } only %}
  {% endstory %}

  {% story secondary with { name: '4. Secondary (link-secondary)', args: { url: '/pagina', label: 'Link secondario' } } %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: create_attribute({'class': ['link-secondary']}),
    } only %}
  {% endstory %}

  {% story danger with { name: '5. Danger (link-danger)', args: { url: '/elimina', label: 'Elimina elemento' } } %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: create_attribute({'class': ['link-danger']}),
    } only %}
  {% endstory %}

{% endstories %}
