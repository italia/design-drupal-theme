{% stories link with { title: 'Bootstrap Italia/Content/Link' } %}

  {% story default with { name: '1. Default', args: { url: 'https://www.example.com', label: 'Read more' } } %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: create_attribute(),
    } only %}
  {% endstory %}

  {% story primary with { name: '2. Primary (link-primary)', args: { url: 'https://www.example.com', label: 'Primary link' } } %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: create_attribute({'class': ['link-primary']}),
    } only %}
  {% endstory %}

  {% story external with { name: '3. External', args: { url: 'https://www.example.com', label: 'External site' } } %}
    {% set link_attr = create_attribute({'class': ['link-primary']}) %}
    {% set link_attr = link_attr.setAttribute('target', '_blank') %}
    {% set link_attr = link_attr.setAttribute('rel', 'noopener noreferrer') %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: link_attr,
    } only %}
  {% endstory %}

  {% story secondary with { name: '4. Secondary (link-secondary)', args: { url: '/page', label: 'Secondary link' } } %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: create_attribute({'class': ['link-secondary']}),
    } only %}
  {% endstory %}

  {% story danger with { name: '5. Danger (link-danger)', args: { url: '/delete', label: 'Delete item' } } %}
    {% include 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: create_attribute({'class': ['link-danger']}),
    } only %}
  {% endstory %}

  {% story with_slots with { name: '6. With slots', args: { url: 'https://www.example.com', label: 'Read the documentation' } } %}
    {% set link_attributes = create_attribute({'class': ['link-primary']}) %}
    {% embed 'bootstrap_italia:link' with {
      url: url,
      label: label,
      attributes: link_attributes,
    } only %}
      {% block before %}
        {% include 'bootstrap_italia:icon' with {
          name: 'it-link',
          size: 'sm',
          color: 'primary',
          decorative: true,
          wrapper_attributes: create_attribute(),
          attributes: create_attribute(),
        } only %}
      {% endblock %}
      {% block after %}
        {% include 'bootstrap_italia:icon' with {
          name: 'it-arrow-right',
          size: 'sm',
          color: 'primary',
          decorative: false,
          label: 'Arrow right'|t,
          wrapper_attributes: create_attribute(),
          attributes: create_attribute(),
        } only %}
      {% endblock %}
    {% endembed %}
  {% endstory %}

  {% story inside_paragraph with { name: '7. Inside paragraph', args: { url: 'https://www.example.com', label: 'inline link' } } %}
    <p>
      {{ 'This sentence contains an'|t }}
      {% include 'bootstrap_italia:link' with {
        url: url,
        label: label,
        attributes: create_attribute({'class': ['link-primary']}),
      } only %}
      {{ 'inside a paragraph.'|t }}
    </p>
  {% endstory %}

  {% story inline_link_with_icon with { name: '8. Inline link with icon', args: { url: '#', label: 'link with icon' } } %}
    <p>
      {{ 'Example of'|t }}
      {% set link_attributes = create_attribute({'class': ['link-primary']}) %}
      {% embed 'bootstrap_italia:link' with {
        url: url,
        label: label,
        attributes: link_attributes,
      } only %}
        {% block after %}
          {% include 'bootstrap_italia:icon' with {
            name: 'it-arrow-right',
            size: 'sm',
            color: 'primary',
            decorative: false,
            label: 'Arrow right'|t,
            wrapper_attributes: create_attribute(),
            attributes: create_attribute(),
          } only %}
        {% endblock %}
      {% endembed %}
    </p>
  {% endstory %}

  {% story inline_link_with_leading_icon with {
    name: '9. Inline link with leading icon',
    args: {
      url: '#',
      label: 'link with icon',
      icon_name: 'it-link',
      icon_assistive_text: 'Link icon'
    },
    argTypes: {
      icon_name: {
        control: { type: 'select' },
        options: ['it-link', 'it-arrow-right', 'it-info-circle', 'it-help-circle', 'it-external-link', 'it-download', 'it-upload', 'it-search', 'it-mail', 'it-user']
      },
      icon_assistive_text: {
        control: { type: 'text' }
      }
    },
    parameters: { controls: { include: ['icon_name', 'icon_assistive_text'] } }
  } %}
    <p>
      {{ 'Example of'|t }}
      {% set link_attributes = create_attribute({'class': ['link-primary']}) %}
      {% embed 'bootstrap_italia:link' with {
        url: url,
        label: label,
        attributes: link_attributes,
      } only %}
        {% block before %}
          {% include 'bootstrap_italia:icon' with {
            name: icon_name|default('it-link'),
            size: 'sm',
            color: 'primary',
            decorative: false,
            label: icon_assistive_text|default('Link icon'|t),
            wrapper_attributes: create_attribute(),
            attributes: create_attribute(),
          } only %}
        {% endblock %}
      {% endembed %}
    </p>
  {% endstory %}

{% endstories %}
