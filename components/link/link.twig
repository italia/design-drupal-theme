{#
/**
 * @file
 * Bootstrap Italia v3 – Link component.
 *
 * A thin <a> wrapper. The caller is responsible for building the correct
 * HTML attributes (classes, target, rel, aria-*, data-*) via the Drupal
 * Attribute object passed as the `attributes` prop.
 *
 * Props:
 *   - url        (string, required): href value.
 *   - label      (string, required): accessible visible link text, rendered inside <span>.
 *   - attributes (object, optional): Drupal Attribute object built with create_attribute().
 *
 * Blocks (available when using {% embed %}):
 *   - before: rendered before <span>{{ label }}</span> — use for leading icons.
 *   - after:  rendered after  <span>{{ label }}</span> — use for trailing icons.
 *
 * Accessibility:
 *   - `label` is required and is the accessible name by default.
 *   - For links opening a new tab/window, the caller should provide the proper
 *     `target`, `rel`, and any extra screen-reader context via `attributes`.
 *   - Decorative icons inserted through blocks should be hidden from assistive
 *     technologies by the caller.
 *
 * ── Usage: simple include ──────────────────────────────────────────────────
 *
 *   {% include 'bootstrap_italia:link' with {
 *     url:   item.url.toString(),
 *     label: item.title,
 *     attributes: create_attribute({'class': ['link-primary']}),
 *   } only %}
 *
 * ── Usage: external link (caller builds attributes) ────────────────────────
 *
 *   {% set link_attr = create_attribute() %}
 *   {% set link_attr = link_attr.addClass('link-secondary') %}
 *   {% set link_attr = link_attr.setAttribute('target', '_blank') %}
 *   {% set link_attr = link_attr.setAttribute('rel', 'noopener noreferrer') %}
 *
 *   {% include 'bootstrap_italia:link' with {
 *     url:        'https://example.com',
 *     label:      'External link',
 *     attributes: link_attr,
 *   } only %}
 *
 * ── Usage: embed with icon blocks ──────────────────────────────────────────
 *
 *   {% embed 'bootstrap_italia:link' with {
 *     url:        path('entity.node.canonical', {node: node.id()}),
 *     label:      node.title.value,
 *     attributes: create_attribute({'class': ['link-primary']}),
 *   } only %}
 *     {% block after %}
 *       {{ icon('bootstrap_italia', 'it-arrow-right', {size: 'sm'}) }}
 *     {% endblock %}
 *   {% endembed %}
 */
#}
{% set link_attributes = attributes|default(create_attribute()) %}

<a href="{{ url }}"{{ link_attributes }}>
  {% block before %}{% endblock %}
  <span>{{ label }}</span>
  {% block after %}{% endblock %}
</a>
