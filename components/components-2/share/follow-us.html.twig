{#
/**
 * @file
 * Template for follow us component.
 * Docs: https://italia.github.io/bootstrap-italia/docs/menu-di-navigazione/header/#header-centrale
 * Latest revision: v2.17.0
 *
 * Parameters:
 * - socials (array) (default: '')
 *   - social-name
 *     - label (string)
 *     - url (url)
 * - title_tag (string) (default 'span')
 * - title_attributes (attributes) (default '')
 * - label (string) (default: '')
 * - blank (boolean) (default: true)
 *   - Open link in new window
 * - socials_inline (boolean) (default: false)
 *   - Display list inline
 * - hide_social_label (boolean) (default: true)
 *   - Display the social name
 * - followus_classes (array) (default: '')
 *   - Wrapper classes
 * - followus_attributes (obj attribute) (default: '')
 *   - Wrapper attributes
 * - social_list_attributes (obj attribute) (default: '')
 *   - List (ul) attributes
 * - social_list_item_attributes (obj attribute) (default: '')
 *   - List item (li) attributes
 * - social_attributes (obj attribute) (default: '')
 *   - Link (a) attributes
 * - icon_color (string) (default: '')
 * - icon_size (string) (default: 'sm')
 * - icon_attributes (obj attribute) (default: '')
 *   - Social icon attributes
 *
 * Examples:
   {% include '@bi-bcl/share/followus.html.twig' with {
      socials: socials,
      label: 'label',
      followus_classes: ['']
   } %}
 *
 */
#}
{% apply spaceless %}
  {# Set defaults #}
  {% set _title_tag = title_tag|default('span') %}
  {% set _title_attributes = title_attributes|default('') %}
  {% set _label = label|default('') %}
  {% set _blank = blank ?? true %}
  {% set _socials_inline = socials_inline ?? false %}
  {% set _hide_social_label = hide_social_label ?? true %}
  {% set _followus_classes = followus_classes|default('') %}
  {% set _followus_attributes = followus_attributes|default('') %}
  {% set _social_list_attributes = social_list_attributes|default('') %}
  {% set _social_list_item_attributes = social_list_item_attributes|default('') %}
  {% set _social_attributes = social_attributes|default('') %}
  {% set _icon_size = icon_size|default('sm') %}
  {% set _icon_color = icon_color|default('') %}
  {% set _icon_attributes = icon_attributes|default('') %}

  {# Set options #}
  {% set _classes = [
    ''
  ] %}

  {% if _followus_classes is not empty %}
    {% set _classes = _classes|merge(followus_classes) %}
  {% endif %}

  {% if _followus_attributes is empty %}
    {% set followus_attributes = create_attribute() %}
  {% endif %}
  {% set followus_attributes = followus_attributes
    .addClass(_classes)
  %}

  {% if _title_attributes is empty %}
    {% set title_attributes = create_attribute() %}
  {% endif %}

  {% if _social_list_attributes is empty %}
    {% set social_list_attributes = create_attribute() %}
  {% endif %}

  {% if _social_list_item_attributes is empty %}
    {% set social_list_item_attributes = create_attribute() %}
  {% endif %}

  {% if _socials_inline %}
    {% set social_list_attributes = social_list_attributes.addClass(['list-inline']) %}
    {% set social_list_item_attributes = social_list_item_attributes.addClass(['list-inline-item']) %}
  {% endif %}

  {% if _social_attributes is empty %}
    {% set social_attributes = create_attribute() %}
  {% endif %}

  {% if _icon_attributes is empty %}
    {% set icon_attributes = create_attribute() %}
  {% endif %}

  {# Component #}
  <div{{ followus_attributes }}>
    <{{ _title_tag }}{{ title_attributes }}>{{ _label }}</{{ _title_tag }}>
    <ul{{ social_list_attributes }}>
      {%- for social in socials -%}
        {%- if social.url -%}
          <li{{ social_list_item_attributes }}>
            {%- set social_attributes = social_attributes
              .setAttribute('href', social.url)
              .setAttribute('rel', 'noopener')
              .setAttribute('aria-label', social.label)
              .addClass('text-'~_icon_color)
            -%}
            {%- if _blank -%}
              {%- set social_attributes = social_attributes
                .setAttribute('target', '_blank')
              -%}
            {%- endif -%}
            <a{{- social_attributes -}}>
              {%- include '@bi-bcl/icon/icon.html.twig' with {
                name: 'it-' ~ (social.label|lower),
                size: _icon_size,
                color: _icon_color,
                icon_classes: ['align-top'],
                icon_attributes: icon_attributes
              } -%}
              <span class="{{ _hide_social_label ? 'visually-hidden-focusable' }}">{{ social.label }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{% endapply %}
