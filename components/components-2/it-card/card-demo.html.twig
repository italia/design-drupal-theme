{#
/**
 * @file
 * Card demo.
 *
 * Example:
 *
   {% include '@bi-bcl/card/card-demo.html.twig' %}
 */
#}
{% apply spaceless %}

  {% set card_demo_title = 'Lorem ipsum dolor sit amet' %}
  {% set card_demo_subtitle = 'Subtitle' %}
  {% set card_demo_text_short = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.' %}
  {% set card_demo_image_url = 'https://placeholderimage.eu/api/nature/800/600' %}
  {% set card_demo_date = '14 Ottobre ' ~ "now"|date("Y") %}
  {% set card_demo_datetime = "now"|date("Y") ~ '-10-14' %}
  {% set card_demo_signature = 'Maria Verde' %}
  {% set card_demo_read_more_url = '#' %}

  {% set card_demo_taxonomy_category %}
    <a href="#" class="it-card-category it-card-link link-secondary"><span class="visually-hidden">{{ 'Related category'|t }}: </span>{{ 'Category'|t }}</a>
  {% endset %}

  {% set card_demo_taxonomy_topics %}
    <ul class="it-card-chips chips-list" aria-label="{{ 'Related topic: '|t }}">
      <li class="list-item">
        {% include '@bi-bcl/chip/chip.html.twig' with {
          chip_label: 'Label'|t,
          chip_a11y_text: 'Topic: ',
          chip_url: '#'
        } %}
      </li>
      <li class="list-item">
        {% include '@bi-bcl/chip/chip.html.twig' with {
          chip_label: 'Label'|t,
          chip_a11y_text: 'Topic: ',
          chip_url: '#'
        } %}
      </li>
    </ul>
  {% endset %}

  {% set card_demo_taxonomy_status %}
    <ul class="it-card-chips chips-list" aria-label="{{ 'Related topic: '|t }}">
      <li class="list-item">
        {% include '@bi-bcl/chip/chip.html.twig' with {
          chip_label: 'Enabled'|t,
          chip_a11y_text: 'Status: ',
          chip_color: 'success'
        } %}
      </li>
    </ul>
  {% endset %}

  {% set card_demo_custom_footer_events1 %}
    {% include '@bi-bcl/button/button.html.twig' with {
      label: 'Register'|t,
      variant: 'link',
      tag: 'a',
      url: '#',
      button_classes: ['it-card-link']
    } %}
  {% endset %}

  {% set card_demo_custom_footer_events2 %}
    {% include '@bi-bcl/button/button.html.twig' with {
      label: 'Register'|t,
      variant: 'secondary',
      outline: true
    } %}
  {% endset %}

  {% set card_demo_custom_footer_attachments %}
    <span class="me-2">{{ 'Download as'|t }}:</span>
    <a href="#" class="it-card-link">ODT (300Kb)<span class="visually-hidden">: {{ 'Document title'|t }}</span></a>
    <a href="#" class="it-card-link">ODS (400Kb)<span class="visually-hidden">: {{ 'Document title'|t }}</span></a>
  {% endset %}

  {% embed '@bi-bcl/demo-container.html.twig' with {
    title: 'it-Card: minimal'|t,
    path_demo_code: '/it-card/card-demo.html.twig#L71',
  } %}
