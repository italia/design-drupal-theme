{% stories button with { title: 'Bootstrap Italia/Components/Button' } %}

  {% story playground with {
    name: '0. Playground',
    args: {
      label: 'Action',
      url: '',
      type: 'button',
      size: '',
      color: 'primary',
      outline: false,
      disabled: false,
      icon_name: '',
      icon_position: 'after'
    },
    argTypes: {
      type: {
        control: { type: 'select' },
        options: ['button', 'submit', 'reset']
      },
      size: {
        control: { type: 'select' },
        options: ['', 'xs', 'sm', 'lg']
      },
      color: {
        control: { type: 'select' },
        options: ['primary', 'secondary', 'success', 'warning', 'danger', 'link']
      },
      outline: {
        control: { type: 'boolean' }
      },
      disabled: {
        control: { type: 'boolean' }
      },
      icon_name: {
        control: { type: 'select' },
        options: ['', 'it-mail', 'it-download', 'it-arrow-right', 'it-link', 'it-search']
      },
      icon_position: {
        control: { type: 'select' },
        options: ['before', 'after']
      }
    },
    parameters: { controls: { include: ['label', 'url', 'type', 'size', 'color', 'outline', 'disabled', 'icon_name', 'icon_position'] } }
  } %}
    {% include 'bootstrap_italia:button' with {
      label: label,
      url: url,
      type: type,
      size: size,
      color: color,
      outline: outline,
      disabled: disabled,
      icon: icon_name ? {
        name: icon_name,
        size: 'sm',
        decorative: true,
      } : {},
      icon_position: icon_position,
    } only %}
  {% endstory %}

  {% story solid_variants with { name: '1. Solid variants' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:button' with { label: 'Primary', color: 'primary' } only %}
      {% include 'bootstrap_italia:button' with { label: 'Secondary', color: 'secondary' } only %}
      {% include 'bootstrap_italia:button' with { label: 'Success', color: 'success' } only %}
      {% include 'bootstrap_italia:button' with { label: 'Warning', color: 'warning' } only %}
      {% include 'bootstrap_italia:button' with { label: 'Danger', color: 'danger' } only %}
    </div>
  {% endstory %}

  {% story outline_variants with { name: '2. Outline variants' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:button' with { label: 'Primary', color: 'primary', outline: true } only %}
      {% include 'bootstrap_italia:button' with { label: 'Secondary', color: 'secondary', outline: true } only %}
      {% include 'bootstrap_italia:button' with { label: 'Success', color: 'success', outline: true } only %}
      {% include 'bootstrap_italia:button' with { label: 'Warning', color: 'warning', outline: true } only %}
      {% include 'bootstrap_italia:button' with { label: 'Danger', color: 'danger', outline: true } only %}
    </div>
  {% endstory %}

  {% story size_variants with { name: '3. Size variants' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:button' with { label: 'Extra small', color: 'primary', size: 'xs' } only %}
      {% include 'bootstrap_italia:button' with { label: 'Small', color: 'primary', size: 'sm' } only %}
      {% include 'bootstrap_italia:button' with { label: 'Default', color: 'primary' } only %}
      {% include 'bootstrap_italia:button' with { label: 'Large', color: 'primary', size: 'lg' } only %}
    </div>
  {% endstory %}

  {% story block_layout with { name: '4. Block layout' } %}
    <div class="d-grid gap-2" style="max-width: 32rem;">
      {% include 'bootstrap_italia:button' with { label: 'Primary block button', color: 'primary', attributes: create_attribute({'class': ['w-100']}) } only %}
      {% include 'bootstrap_italia:button' with { label: 'Secondary block button', color: 'secondary', attributes: create_attribute({'class': ['w-100']}) } only %}
    </div>
  {% endstory %}

  {% story state_matrix with { name: '5. State matrix' } %}
    <div class="py-1">
      <div class="btn-example mb-3">
        {% include 'bootstrap_italia:button' with { label: 'Primary', color: 'primary' } only %}
        {% include 'bootstrap_italia:button' with { label: 'Primary outline', color: 'primary', outline: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Primary disabled', color: 'primary', disabled: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Primary outline disabled', color: 'primary', outline: true, disabled: true } only %}
      </div>
      <div class="btn-example mb-3">
        {% include 'bootstrap_italia:button' with { label: 'Secondary', color: 'secondary' } only %}
        {% include 'bootstrap_italia:button' with { label: 'Secondary outline', color: 'secondary', outline: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Secondary disabled', color: 'secondary', disabled: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Secondary outline disabled', color: 'secondary', outline: true, disabled: true } only %}
      </div>
      <div class="btn-example mb-3">
        {% include 'bootstrap_italia:button' with { label: 'Success', color: 'success' } only %}
        {% include 'bootstrap_italia:button' with { label: 'Success outline', color: 'success', outline: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Success disabled', color: 'success', disabled: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Success outline disabled', color: 'success', outline: true, disabled: true } only %}
      </div>
      <div class="btn-example mb-3">
        {% include 'bootstrap_italia:button' with { label: 'Danger', color: 'danger' } only %}
        {% include 'bootstrap_italia:button' with { label: 'Danger outline', color: 'danger', outline: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Danger disabled', color: 'danger', disabled: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Danger outline disabled', color: 'danger', outline: true, disabled: true } only %}
      </div>
      <div class="btn-example mb-3">
        {% include 'bootstrap_italia:button' with { label: 'Warning', color: 'warning' } only %}
        {% include 'bootstrap_italia:button' with { label: 'Warning outline', color: 'warning', outline: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Warning disabled', color: 'warning', disabled: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Warning outline disabled', color: 'warning', outline: true, disabled: true } only %}
      </div>
    </div>
  {% endstory %}

  {% story dark_state_matrix with { name: '6. Dark state matrix' } %}
    <div class="bg-dark p-5">
      <div class="btn-example mb-3">
        {% include 'bootstrap_italia:button' with { label: 'Primary', color: 'primary' } only %}
        {% include 'bootstrap_italia:button' with { label: 'Primary outline', color: 'primary', outline: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Primary disabled', color: 'primary', disabled: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Primary outline disabled', color: 'primary', outline: true, disabled: true } only %}
      </div>
      <div class="btn-example">
        {% include 'bootstrap_italia:button' with { label: 'Secondary', color: 'secondary' } only %}
        {% include 'bootstrap_italia:button' with { label: 'Secondary outline', color: 'secondary', outline: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Secondary disabled', color: 'secondary', disabled: true } only %}
        {% include 'bootstrap_italia:button' with { label: 'Secondary outline disabled', color: 'secondary', outline: true, disabled: true } only %}
      </div>
    </div>
  {% endstory %}

  {% story link_buttons with { name: '7. Link buttons' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:button' with {
        label: 'Read more',
        url: '/read-more',
        color: 'primary',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Open service',
        url: '/service',
        color: 'secondary',
        outline: true,
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Disabled link',
        url: '/disabled-link',
        color: 'primary',
        disabled: true,
      } only %}
    </div>
  {% endstory %}

  {% story disabled_state with { name: '8. Disabled state' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:button' with {
        label: 'Disabled button',
        color: 'primary',
        disabled: true,
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Disabled link',
        url: '/disabled-link',
        color: 'secondary',
        disabled: true,
      } only %}
    </div>
  {% endstory %}

  {% story with_icons with { name: '9. With icons' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap mb-3">
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'success',
        size: 'lg',
        icon: {name: 'it-star-full'},
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'primary',
        icon: {name: 'it-star-full'},
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'danger',
        icon: {name: 'it-star-full'},
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'secondary',
        size: 'xs',
        icon: {name: 'it-star-full'},
      } only %}
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap mb-3">
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'secondary',
        outline: true,
        size: 'xs',
        icon: {name: 'it-star-full'},
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'danger',
        outline: true,
        icon: {name: 'it-star-full'},
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'primary',
        outline: true,
        icon: {name: 'it-star-full'},
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Add to bookmarks',
        color: 'success',
        outline: true,
        size: 'lg',
        icon: {name: 'it-star-full'},
      } only %}
    </div>

    <div class="d-flex gap-2 align-items-center flex-wrap mb-3">
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'success',
        size: 'lg',
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'primary',
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'danger',
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'secondary',
        size: 'xs',
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap mb-3">
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'secondary',
        outline: true,
        size: 'xs',
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'danger',
        outline: true,
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'primary',
        outline: true,
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'User profile',
        color: 'success',
        outline: true,
        size: 'lg',
        icon: {name: 'it-user'},
        icon_position: 'before',
      } only %}
    </div>
  {% endstory %}

  {% story toggle_buttons with { name: '10. Toggle buttons' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:button' with {
        label: 'Toggle primary',
        color: 'primary',
        type: 'button',
        attributes: create_attribute({'data-bs-toggle': 'button'}),
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Toggle outline',
        color: 'secondary',
        outline: true,
        type: 'button',
        attributes: create_attribute({'data-bs-toggle': 'button'}),
      } only %}
    </div>
  {% endstory %}

  {% story with_badge with { name: '11. With badge' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% embed 'bootstrap_italia:button' with {
        label: 'Notifications',
        color: 'primary',
      } only %}
        {% block after %}
          {% include 'bootstrap_italia:badge' with {
            label: '4',
            color: 'inverse',
            small: true,
            rounded: true,
          } only %}
        {% endblock %}
      {% endembed %}

      {% embed 'bootstrap_italia:button' with {
        label: 'Messages',
        color: 'secondary',
      } only %}
        {% block after %}
          {% include 'bootstrap_italia:badge' with {
            label: '7',
            color: 'inverse',
            small: true,
            rounded: true,
          } only %}
          <span class="visually-hidden">{{ 'unread messages'|t }}</span>
        {% endblock %}
      {% endembed %}
    </div>
  {% endstory %}

  {% story form_actions with { name: '12. Form actions' } %}
    <div class="d-flex gap-2 align-items-center flex-wrap">
      {% include 'bootstrap_italia:button' with {
        label: 'Save changes',
        color: 'primary',
        type: 'submit',
      } only %}
      {% include 'bootstrap_italia:button' with {
        label: 'Reset form',
        color: 'danger',
        type: 'reset',
      } only %}
    </div>
  {% endstory %}

{% endstories %}
