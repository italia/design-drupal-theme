{#
/**
 * @file
 * Bootstrap Italia v3 – Button component.
 *
 * Interactive button primitive.
 *
 * The component always injects the base `.btn` class.
 * Use `url` only for real navigation. When `url` is provided, the component
 * renders an `<a>`. Otherwise it renders a semantic `<button>`.
 *
 * Last revision: v3.0.0-alpha.6
 *
 * Accessibility contract:
 *   - Use `<button>` for in-page actions such as toggles, dialogs, form
 *     actions, or JavaScript interactions that do not navigate.
 *   - Use `<a>` only when the action changes location or opens a real
 *     destination.
 *   - This component does not style non-interactive elements as buttons.
 *   - This component does not add `role="button"` to links, because links used
 *     here are expected to remain semantic navigation elements.
 *
 * Props:
 *   - variant       (string, optional): Optional SDC variant used as a
 *                                       convenience layer to derive internal
 *                                       defaults using the pattern
 *                                       `{tone}[__{modifier}]*`. Supported
 *                                       tones: `primary`, `secondary`,
 *                                       `success`, `warning`, `danger`,
 *                                       `link`. Supported modifiers:
 *                                       `outline`, `xs`, `sm`, `lg`.
 *   - type          (string, optional): Button type used for the `<button>`
 *                                       variant. Defaults to `button`.
 *   - label         (string, required): Visible button text.
 *   - url           (string, optional): When provided, forces rendering as an
 *                                       `<a>` and maps the value to `href`.
 *   - size          (string, optional): Size variant appended as `.btn-{size}`.
 *                                       Example: `sm`, `lg`.
 *   - color         (string, optional): Color variant appended as `.btn-{color}`
 *                                       or `.btn-outline-{color}`. Default:
 *                                       `primary`.
 *   - outline       (boolean, optional): When true, uses the outline color
 *                                       variant.
 *   - disabled      (boolean, optional): Disables the button. On links, sets
 *                                       `aria-disabled="true"` and adds the
 *                                       `disabled` class for visual parity.
 *   - icon          (object, optional): Context passed to the
 *                                       `bootstrap_italia:icon` component.
 *   - icon_position (string, optional): Icon placement. Supported values:
 *                                       `before`, `after`. Default: `after`.
 *   - attributes    (object, optional): Drupal Attribute object applied to the
 *                                       root element.
 *
 * Slots: none.
 *
 * Blocks (available when using {% embed %}):
 *   - before: Rendered before the label. By default, renders the icon when
 *             `icon` is provided and `icon_position` is `before`.
 *   - after:  Rendered after the label. By default, renders the icon when
 *             `icon` is provided and `icon_position` is `after`.
 *
 * ── Usage: primary button ────────────────────────────────────────────────
 *   {% include 'bootstrap_italia:button' with {
 *     label: 'Confirm',
 *     color: 'primary',
 *   } only %}
 *
 * ── Usage: outline link button ───────────────────────────────────────────
 *   {% include 'bootstrap_italia:button' with {
 *     label: 'Learn more',
 *     url: '/learn-more',
 *     color: 'primary',
 *     outline: true,
 *   } only %}
 *
 * ── Usage: icon button ────────────────────────────────────────────────────
 *   {% include 'bootstrap_italia:button' with {
 *     label: 'Send email',
 *     color: 'primary',
 *     icon: {
 *       name: 'it-mail',
 *       size: 'sm',
 *       decorative: true,
 *     },
 *     icon_position: 'before',
 *   } only %}
 *
 * ── Usage: custom trailing content via embed ─────────────────────────────
 *   {% embed 'bootstrap_italia:button' with {
 *     label: 'Messages',
 *     color: 'secondary',
 *   } only %}
 *     {% block after %}
 *       {% include 'bootstrap_italia:badge' with {
 *         label: '7',
 *         color: 'inverse',
 *         small: true,
 *         rounded: true,
 *       } only %}
 *     {% endblock %}
 *   {% endembed %}
 */
#}
{% apply spaceless %}
  {# Defaults #}
  {% set _variant = variant|default('') %}
  {% set _variant_parts = _variant ? _variant|split('__') : [] %}
  {% set _variant_tone = _variant_parts|length ? _variant_parts|first : '' %}
  {% set _variant_modifiers = _variant_parts|slice(1) %}
  {% set _variant_color = _variant_tone in ['primary', 'secondary', 'success', 'warning', 'danger', 'link'] ? _variant_tone : '' %}
  {% set _variant_outline = 'outline' in _variant_modifiers %}
  {% set _variant_size = '' %}
  {% if 'xs' in _variant_modifiers %}
    {% set _variant_size = 'xs' %}
  {% elseif 'sm' in _variant_modifiers %}
    {% set _variant_size = 'sm' %}
  {% elseif 'lg' in _variant_modifiers %}
    {% set _variant_size = 'lg' %}
  {% endif %}
  {% set _type = type|default('button') %}
  {% set _label = label|default('') %}
  {% set _url = url|default('') %}
  {% set _size = size|default(_variant_size) %}
  {% set _color = color|default(_variant_color ?: 'primary') %}
  {% set _outline = outline ?? _variant_outline %}
  {% set _disabled = disabled ?? false %}
  {% set _icon = icon|default({}) %}
  {% set _icon_position = icon_position|default('after') %}
  {% set _attributes = attributes|default(create_attribute()) %}

  {# Tag settings #}
  {% set _tag = _url is not empty ? 'a' : 'button' %}

  {% if _tag == 'a' %}
    {% set _attributes = _attributes.setAttribute('href', _url) %}
  {% else %}
    {% set _attributes = _attributes.removeAttribute('href') %}
    {% set _attributes = _attributes.setAttribute('type', _type) %}
  {% endif %}

  {# Accessibility settings #}
  {% if _tag == 'a' and _disabled %}
    {% set _attributes = _attributes.setAttribute('aria-disabled', 'true') %}
    {% set _attributes = _attributes.setAttribute('tabindex', '-1') %}
  {% elseif _disabled %}
    {% set _attributes = _attributes.setAttribute('disabled', true) %}
  {% endif %}

  {# Configuration #}
  {% set _classes = [
    'btn',
    _outline and _color is not empty ? 'btn-outline-' ~ _color,
    not _outline and _color is not empty ? 'btn-' ~ _color,
    _size is not empty ? 'btn-' ~ _size,
    _disabled ? 'disabled',
    _icon is not empty ? 'btn-icon',
  ] %}

  {% set _attributes = _attributes.setAttribute(
    'class',
    _classes|merge(_attributes.class|default([]))
  ) %}

  {# Component #}
  <{{ _tag }}{{ _attributes }}>
    {% block before %}
      {% if _icon is not empty and _icon_position == 'before' %}
        <span class="rounded-icon">
          {% include 'bootstrap_italia:icon' with _icon|merge({
            size: _outline and _size == 'lg' ? 'sm' : 'xs',
            color: _color,
          }) only %}
        </span>
      {% endif %}
    {% endblock %}

    {% if _icon is not empty %}
      <span>{{ _label }}</span>
    {% else %}
      {{- _label -}}
    {% endif %}

    {% block after %}
      {% if _icon is not empty and _icon_position == 'after' %}
        {% include 'bootstrap_italia:icon' with _icon|merge({
          size: _size == 'xs' ? 'xs' : 'sm',
          color: not _outline ? 'inverse' : _color,
        }) only %}
      {% endif %}
    {% endblock %}
  </{{ _tag }}>

{% endapply %}
