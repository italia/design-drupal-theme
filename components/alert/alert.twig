{#
/**
 * @file
 * Bootstrap Italia v3 – Alert component.
 *
 * Thin wrapper around the Bootstrap Italia alert pattern.
 * The component always renders a root `<div>` with `role="alert"` and injects
 * the base `.alert` class plus the contextual `.alert-{color}` class.
 * By default it renders a single `<p class="mb-0">` containing the optional
 * leading icon and the `content` slot.
 *
 * Last revision: v3.0.0-alpha.6
 *
 * Props:
 *   - variant      (string): Optional SDC variant used as a convenience layer
 *                            to derive internal defaults using the pattern
 *                            `{tone}[__{modifier}]*`. Supported tones:
 *                            `primary`, `secondary`, `success`, `warning`,
 *                            `danger`, `info`. Supported modifiers:
 *                            `dismissible`.
 *   - color        (string): Optional contextual variant such as `primary`,
 *                            `secondary`, `info`, `success`, `warning`, or
 *                            `danger`. Defaults to `info`.
 *   - icon         (object): Optional context forwarded to the
 *                            `bootstrap_italia:icon` component.
 *   - default_icon (bool):   When `true` and `icon` is empty, a preset icon is
 *                            built for `primary`, `secondary`, `success`,
 *                            `warning`, and `danger`. Defaults to `false`.
 *   - dismissible  (bool):   When `true`, adds dismissible alert classes.
 *                            Defaults to `false`.
 *   - dismissible_effects (array): Optional extra classes added only when
 *                            `dismissible` is `true`. Defaults to
 *                            `['fade', 'show']`.
 *   - dismiss_label (string): Optional accessible label applied to the close
 *                            button when `dismissible` is `true`. Defaults to
 *                            `Close this alert`.
 *   - attributes   (Drupal\Core\Template\Attribute): Attributes applied to the
 *                            root `<div>`.
 *
 * Slots:
 *   - content: Inline alert body rendered inside the default
 *              `<p class="mb-0">`.
 *
 * Blocks (available when using {% embed %}):
 *   - alert_content: Rendered inside the root alert `<div>`. By default,
 *             renders the standard alert
 *             body as a single `<p class="mb-0">` containing the optional icon
 *             and the `content` slot. Override this block when you need
 *             multiple paragraphs or a different body structure.
 *
 * ── Usage: simple alert with default body ─────────────────────────────────
 *   {% set alert_content %}
 *     Operation completed successfully.
 *   {% endset %}
 *   {% include 'bootstrap_italia:alert' with {
 *     color: 'success',
 *     default_icon: true,
 *     content: alert_content,
 *   } only %}
 *
 * ── Usage: custom body structure via embed ────────────────────────────────
 *   {% embed 'bootstrap_italia:alert' with {
 *     color: 'warning',
 *     content: 'Warning: review the data before continuing.',
 *   } only %}
 *     {% block alert_content %}
 *       <p class="mb-0">
 *         {% include 'bootstrap_italia:icon' with {
 *           name: 'it-warning-circle',
 *           label: 'warning',
 *           wrapper_attributes: create_attribute({'class': ['alert-icon']}),
 *         } only %}
 *         {{ content }}
 *       </p>
 *       <p class="mb-0">Additional detail in a second paragraph.</p>
 *     {% endblock %}
 *   {% endembed %}
 *
 * ── Usage: explicit a11y icon text without default mapping ────────────────
 *   {% include 'bootstrap_italia:alert' with {
 *     color: 'primary',
 *     icon: {
 *       name: 'it-info-circle',
 *       label: 'This is an information',
 *       wrapper_attributes: create_attribute({'class': ['alert-icon']}),
 *     },
 *     content: 'This is an informational alert.',
 *   } only %}
 *
 * ── Usage: dismissible alert ───────────────────────────────────────────────
 *   {% include 'bootstrap_italia:alert' with {
 *     color: 'warning',
 *     dismissible: true,
 *     dismiss_label: 'Close alert',
 *     content: 'Review the highlighted fields before submitting.',
 *   } only %}
 */
#}
{% apply spaceless %}
  {# Defaults #}
  {% set _variant = variant|default('') %}
  {% set _variant_parts = _variant ? _variant|split('__') : [] %}
  {% set _variant_tone = _variant_parts|length ? _variant_parts|first : '' %}
  {% set _variant_modifiers = _variant_parts|slice(1) %}
  {% set _variant_color = _variant_tone in ['primary', 'secondary', 'success', 'warning', 'danger'] ? _variant_tone : '' %}
  {% set _variant_dismissible = 'dismissible' in _variant_modifiers %}

  {% set _color = color|default(_variant_color ?: 'secondary') %}
  {% set _icon = icon|default({}) %}
  {% set _default_icon = default_icon ?? false %}
  {% set _dismissible = dismissible ?? _variant_dismissible %}
  {% set _dismissible_effects = dismissible_effects|default(['fade', 'show']) %}
  {% set _dismiss_label = dismiss_label|default('Close this alert') %}
  {% set _attributes = attributes|default(create_attribute()) %}

  {# Accessibility settings #}
  {% set _attributes = _attributes.setAttribute('role', 'alert') %}

  {# Configuration #}
  {% set _classes = [
    'alert',
    _color is not empty ? 'alert-' ~ _color,
    _dismissible ? 'alert-dismissible',
  ] %}

  {% set _classes = _classes|merge(_dismissible ? _dismissible_effects : []) %}

  {% set _attributes = _attributes.setAttribute(
    'class',
    _classes|merge(_attributes.class|default([]))
  ) %}

  {% set _default_icon_maps = {
    primary: 'it-info-circle',
    secondary: 'it-info-circle',
    success: 'it-check-circle',
    warning: 'it-warning-circle',
    danger: 'it-error',
  } %}

  {% if _default_icon and _icon is empty %}
    {% set _icon = {
      name: _default_icon_maps[_color],
      color: _color,
      wrapper_attributes: create_attribute().addClass(['alert-icon']),
      attributes: create_attribute(),
    } %}
  {% endif %}

  {# Component #}
  <div{{ _attributes }}>
    {% block alert_content %}
      <p class="mb-0">
        {% if _icon is not empty %}
          {% include 'bootstrap_italia:icon' with _icon|merge({
            wrapper_attributes: _icon.wrapper_attributes|default(create_attribute()),
            attributes: _icon.attributes|default(create_attribute()),
          }) only %}
        {% endif %}
        {{ content }}
      </p>
    {% endblock %}
    {% if _dismissible %}
      <button type="button" class="btn-close" data-bs-dismiss="alert"{% if _dismiss_label is not empty %} aria-label="{{ _dismiss_label }}"{% endif %}>
        {% include 'bootstrap_italia:icon' with {
          name: 'it-close',
          decorative: true,
          wrapper_attributes: create_attribute(),
          attributes: create_attribute(),
        } only %}
      </button>
    {% endif %}
  </div>
{% endapply %}
