{% stories alert with { title: 'Bootstrap Italia/Components/Alert' } %}

  {% story contextual_alerts with { name: '1. Contextual alerts' } %}
    {% set primary_content %}
      This is a "<strong>primary</strong>" alert.
    {% endset %}
    {% set info_content %}
      This is an "<strong>info</strong>" alert.
    {% endset %}
    {% set success_content %}
      This is a "<strong>success</strong>" alert.
    {% endset %}
    {% set warning_content %}
      This is a "<strong>warning</strong>" alert.
    {% endset %}
    {% set danger_content %}
      This is a "<strong>danger</strong>" alert.
    {% endset %}

    <div class="d-flex flex-column gap-3">
      {% include 'bootstrap_italia:alert' with {
        color: 'primary',
        default_icon: true,
        content: primary_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        color: 'secondary',
        default_icon: true,
        content: info_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        color: 'success',
        default_icon: true,
        content: success_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        color: 'warning',
        default_icon: true,
        content: warning_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        color: 'danger',
        default_icon: true,
        content: danger_content,
        attributes: create_attribute(),
      } only %}
    </div>
  {% endstory %}

  {% story alert_with_link with { name: '2. Alert with link' } %}
    {% set linked_content %}
      This is an alert with an example of a highlighted <a href="#" class="alert-link">link</a>.
    {% endset %}
    {% include 'bootstrap_italia:alert' with {
      color: 'danger',
      content: linked_content,
      attributes: create_attribute(),
    } only %}
  {% endstory %}

  {% story alert_with_heading with { name: '3. Alert with heading' } %}
    {% embed 'bootstrap_italia:alert' with {
      color: 'success',
      attributes: create_attribute(),
    } only %}
      {% block alert_content %}
        <h4 class="alert-heading">Success alert!</h4>
        <p>
          You are reading this important success alert message. This example text
          is going to run a bit longer so that you can see how spacing works
          within an alert with this kind of content.
        </p>
        <hr>
        <p class="mb-0">
          Whenever you need to, be sure to use margin utilities to keep things
          nicely aligned.
        </p>
      {% endblock %}
    {% endembed %}
  {% endstory %}

  {% story dismissible_alert with { name: '4. Dismissible alert' } %}
    {% set dismissible_content %}
      <strong>Warning</strong> Some entered fields need to be checked.
    {% endset %}
    {% include 'bootstrap_italia:alert' with {
      color: 'warning',
      dismissible: true,
      dismiss_label: 'Close alert',
      content: dismissible_content,
      attributes: create_attribute(),
    } only %}
  {% endstory %}

  {% story variants with { name: '5. Variants' } %}
    {% set primary_variant_content %}
      Variant <code>primary</code> only.
    {% endset %}
    {% set secondary_variant_content %}
      Variant <code>secondary</code> only.
    {% endset %}
    {% set success_variant_content %}
      Variant <code>success</code> only.
    {% endset %}
    {% set warning_content %}
      Variant <code>warning</code> only.
    {% endset %}
    {% set danger_content %}
      Variant <code>danger</code> only.
    {% endset %}
    {% set info_variant_content %}
      Variant <code>info</code> only.
    {% endset %}
    {% set dismissible_variant_content %}
      Variant <code>warning__dismissible</code> only.
    {% endset %}

    <div class="d-flex flex-column gap-3">
      {% include 'bootstrap_italia:alert' with {
        variant: 'primary',
        content: primary_variant_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        variant: 'secondary',
        content: secondary_variant_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        variant: 'success',
        content: success_variant_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        variant: 'warning',
        content: warning_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        variant: 'danger',
        content: danger_content,
        attributes: create_attribute(),
      } only %}
      {% include 'bootstrap_italia:alert' with {
        variant: 'warning__dismissible',
        dismiss_label: 'Close alert',
        content: dismissible_variant_content,
        attributes: create_attribute(),
      } only %}
    </div>
  {% endstory %}

{% endstories %}
