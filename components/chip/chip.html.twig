{#
/**
 * @file
 * Bootstrap Italia v3 – Chip component.
 *
 * Props:
 *   - label (string, required): chip text.
 *   - href (string): makes the label a link.
 *   - color (string): primary | secondary | success | warning | danger
 *   - size (string): lg
 *   - disabled (bool): adds chip-disabled class.
 *   - closable (bool): shows close button.
 *   - close_label (string): accessible label for close button (default: "Rimuovi").
 *   - icon (object): nested icon props { name, size }
 *   - avatar (object): nested avatar props
 *
 * Usage:
 *   {% include 'bootstrap_italia:chip' with { label: 'Categoria' } only %}
 *   {% include 'bootstrap_italia:chip' with {
 *     label: 'Ambiente',
 *     color: 'primary',
 *     closable: true,
 *     icon: { name: 'leaf' }
 *   } only %}
 */
#}
{% set classes = [
  'chip',
  color ? 'chip-' ~ color,
  size ? 'chip-' ~ size,
  disabled ? 'chip-disabled',
] | filter(v => v) %}

<div class="{{ classes | join(' ') }}">
  {% if icon %}
    {% include 'bootstrap_italia:icon' with icon only %}
  {% endif %}

  {% if avatar %}
    {% include 'bootstrap_italia:avatar' with avatar only %}
  {% endif %}

  {% if href %}
    <a class="chip-label" href="{{ href }}">{{ label }}</a>
  {% else %}
    <span class="chip-label">{{ label }}</span>
  {% endif %}

  {% if closable %}
    <button class="btn-close" aria-label="{{ close_label | default('Rimuovi') }}"></button>
  {% endif %}
</div>
