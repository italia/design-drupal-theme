{#
/**
 * @file
 * Bootstrap Italia v3 – Icon component.
 *
 * Thin <svg> wrapper. The caller controls all modifier classes via the
 * attributes prop. The base .icon class is always added automatically.
 *
 * Refs:
 *  - https://bootstrap-italia-git-3x-dip-trasformazione-digitale.vercel.app/docs/utilities/icone/
 *  - https://italia.github.io/dev-kit-italia/?path=/docs/componenti-icon--documentazione
 *
 * Last revision: v3.0.0-alpha.6
 *
 * Props:
 *   - name       (string, required): Sprite icon ID, for example `it-arrow-right`.
 *   - label      (string): Accessible text for non-decorative icons. If omitted,
 *                          the component falls back to the icon name.
 *   - align      (string): Optional vertical alignment modifier: `bottom`,
 *                          `middle`, or `top`.
 *   - padded     (bool):   Adds the `icon-padded` utility class. Defaults to `false`.
 *   - size       (string): Optional size modifier: `xs`, `sm`, `lg`, or `xl`.
 *   - color      (string): Optional color modifier such as `primary`,
 *                          `secondary`, `success`, `warning`, `danger`,
 *                          `disabled`, `inverse`, `light`, or `white`.
 *   - src        (string): Path to the SVG sprite file. Defaults to the
 *                          Bootstrap Italia sprite shipped with the theme.
 *   - decorative (bool):   When `true`, the icon is hidden from assistive
 *                          technologies. Defaults to `true`.
 *   - wrapper_attributes (Drupal\Core\Template\Attribute): Attributes applied to
 *                          the outer `<svg>` element.
 *   - attributes (Drupal\Core\Template\Attribute): Attributes applied to the
 *                          inner `<use>` element.
 *
 * Slots: none.
 *
 * ── Usage: default ────────────────────────────────────────────────────────
 *   {% include 'bootstrap_italia:icon' with { name: 'it-arrow-right' } only %}
 *
 * ── Usage: large, primary ──────────────────────────────────────────────────
 *   {% include 'bootstrap_italia:icon' with {
 *     name: 'it-check-circle',
 *     size: 'lg',
 *     color: 'primary',
 *   } only %}
 *
 * ── Usage: padded, aligned middle ─────────────────────────────────────────
 *   {% include 'bootstrap_italia:icon' with {
 *     name: 'it-info-circle',
 *     align: 'middle'
 *     padded: true,
 *     size: 'lg',
 *   } only %}
 */
#}
{% apply spaceless %}
  {# Defaults #}
  {% set _name = name|default('it-warning-circle') %}
  {% set _label = label|default('') %}
  {% set _align = align|default('') %}
  {% set _padded = padded ?? false %}
  {% set _size = size|default('') %}
  {% set _color = color|default('') %}
  {% set _src = src|default('/libraries/italia.bootstrap-italia/svg/sprites.svg') %}
  {% set _decorative = decorative ?? true %}
  {% set _wrapper_attributes = wrapper_attributes|default(create_attribute()) %}
  {% set _attributes = attributes|default(create_attribute()) %}

  {# Accessibility settings #}
  {% if not _decorative and _label is empty %}
    {# Set fallback label #}
    {% set _label = _name %}
  {% endif %}

  {% if _label is not empty %}
    {% set _label_id = _name ~ '--label-' ~ random() %}
    {% set _wrapper_attributes = _wrapper_attributes
      .setAttribute('role', 'img')
      .setAttribute('aria-labelledby', _label_id)
    %}
  {% else %}
    {% set _wrapper_attributes = _wrapper_attributes
      .setAttribute('role', 'presentation')
      .setAttribute('aria-hidden', 'true')
    %}
  {% endif %}

  {# Configuration #}
  {% set _wrapper_classes = [
    'icon',
    _align ? 'align-' ~ _align,
    _padded ? 'icon-padded',
    _size ? 'icon-' ~ _size,
    _color ? 'icon-' ~ _color,
  ] %}

  {% set _wrapper_attributes = _wrapper_attributes.addClass(_wrapper_classes) %}

  {% set _attributes = _attributes
    .setAttribute('href', _src ~ '#' ~ _name)
    .setAttribute('xlink:href', _src ~ '#' ~ _name)
  %}

  {# Component #}
  <svg{{ _wrapper_attributes }}>
    {% if _label is not empty %}
      <title id="{{ _label_id }}">{{ _label }}</title>
    {% endif %}
    <use{{ _attributes }}"></use>
  </svg>
{% endapply %}
